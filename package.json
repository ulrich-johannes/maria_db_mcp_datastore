{
  "name": "datastore-mcp",
  "version": "1.0.0",
  "description": "Remote MCP server backed by MariaDB, providing a CRUD key/value state store for AI assistants.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "mariadb": "^3.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
